<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
    <PassAiProArtifactsRoot Condition="'$(PassAiProArtifactsRoot)' == ''">D:\PASS_AI\TEST\automated\pass-ai-pro-invalid-input</PassAiProArtifactsRoot>
    <PassAiProArtifactsRoot>$([System.IO.Path]::GetFullPath('$(PassAiProArtifactsRoot)'))</PassAiProArtifactsRoot>
    <BaseIntermediateOutputPath>$(PassAiProArtifactsRoot)\obj\$(MSBuildProjectName)\$(Configuration)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <OutputPath>$(PassAiProArtifactsRoot)\bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <RestorePackagesPath>$(PassAiProArtifactsRoot)\packages</RestorePackagesPath>
    <PathMap>$(MSBuildThisFileDirectory)=/_/PASS_AI_PRO,$(PassAiProArtifactsRoot)=/_/artifacts</PathMap>
    <Version>$(PassAiProVersion)</Version>
    <AssemblyVersion>$(PassAiProVersion).0</AssemblyVersion>
    <FileVersion>$(PassAiProVersion).0</FileVersion>
    <InformationalVersion>$(PassAiProVersion)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="[1.0.3]" PrivateAssets="All" />
  </ItemGroup>
</Project>
